"Refract"
{
    "$model" "1"
    "$nodecal" "1"
    "$nocull" "1"
    "$translucent" "1"
    "$surfaceprop" "default_silent"
    "$nowritez" "1"
    "$bluramount" "0"
    "$refractamount" "0.006"
    "$refracttint" "[1 1 1]"
    "$fadeoutonsilhouette" "0"
    "$normalmap" "models/campaign_evolved/ce8/material_sets/weapons/jackal_shield/textures/barrier_distort"
    "$energyoffset" "[0 0 0]"
    "$energyscale" "[3.000000000 0.349999990 1]"
    "$energycenter" "[0 0 0]"
    "$bumptransform" "center 0 0 scale 1 1 rotate 0 translate 0 0"
    "Proxies"
    {
        "CE8Energy"
        {
            "Kind" "shield"
            "RefractAmount" "0.006"
        }
        "TextureScroll"
        {
            "textureScrollVar" "$energyoffset"
            "textureScrollRate" "0.056402571"
            "textureScrollAngle" "102.804266065"
        }
        "TextureTransform"
        {
            "centerVar" "$energycenter"
            "scaleVar" "$energyscale"
            "translateVar" "$energyoffset"
            "resultVar" "$bumptransform"
        }
    }
}
