"UnlitGeneric"
{
    "$model" "1"
    "$nodecal" "1"
    "$nocull" "1"
    "$translucent" "1"
    "$additive" "1"
    "$alpha" "1"
    "$surfaceprop" "default_silent"
    "$basetexture" "models/campaign_evolved/ce8/material_sets/weapons/energy_sword/textures/blade_glow"
    "$receiveflashlight" "0"
    "$energyoffset" "[0 0 0]"
    "$energyscale" "[3.000000000 2.000000000 1]"
    "$energycenter" "[0 0 0]"
    "$detailtexturetransform" "center 0 0 scale 1 1 rotate 0 translate 0 0"
    "$detail" "models/campaign_evolved/ce8/material_sets/weapons/jackal_shield/textures/barrier_flow"
    "$detailscale" "1"
    "$detailblendmode" "7"
    "$detailblendfactor" ".8"
    "$energyrotate" "-90.0"
    "Proxies"
    {
        "CE8Energy"
        {
            "Kind" "blade"
            "DetailStrength" ".8"
            "RefractMaterial" "models/campaign_evolved/ce8/material_sets/weapons/energy_sword/blade_refract"
            "FarMaterial" "models/campaign_evolved/ce8/material_sets/weapons/energy_sword/blade_far"
        }
        "TextureScroll"
        {
            "textureScrollVar" "$energyoffset"
            "textureScrollRate" "1.004987562"
            "textureScrollAngle" "-5.710593222"
        }
        "TextureTransform"
        {
            "centerVar" "$energycenter"
            "scaleVar" "$energyscale"
            "translateVar" "$energyoffset"
            "resultVar" "$detailtexturetransform"
            "rotateVar" "$energyrotate"
        }
    }
}
