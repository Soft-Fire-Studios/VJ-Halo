"Refract"
{
    "$model" "1"
    "$nodecal" "1"
    "$nocull" "1"
    "$translucent" "1"
    "$surfaceprop" "default_silent"
    "$nowritez" "1"
    "$bluramount" "0"
    "$refractamount" "0.008"
    "$refracttint" "[1 1 1]"
    "$fadeoutonsilhouette" "0"
    "$normalmap" "models/campaign_evolved/ce8/material_sets/weapons/energy_sword/textures/blade_refract_nm"
    "$normalmap2" "models/campaign_evolved/ce8/material_sets/weapons/energy_sword/textures/blade_distort"
    "$energyoffset" "[0 0 0]"
    "$energyscale" "[1.000000000 0.699999990 1]"
    "$energycenter" "[0 0 0]"
    "$bumptransform2" "center 0 0 scale 1 1 rotate 0 translate 0 0"
    "Proxies"
    {
        "CE8Energy"
        {
            "Kind" "blade"
            "RefractAmount" "0.008"
        }
        "TextureScroll"
        {
            "textureScrollVar" "$energyoffset"
            "textureScrollRate" "0.756637298"
            "textureScrollAngle" "97.594643369"
        }
        "TextureTransform"
        {
            "centerVar" "$energycenter"
            "scaleVar" "$energyscale"
            "translateVar" "$energyoffset"
            "resultVar" "$bumptransform2"
        }
    }
}
