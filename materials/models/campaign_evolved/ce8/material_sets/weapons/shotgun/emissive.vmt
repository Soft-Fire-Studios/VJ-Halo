"screenspace_general_8tex"
{
    "$model" "1"
    "$nodecal" "1"
    "$pixshader" "ce8_gauge_v1_ps30"
    "$vertexshader" "ce8_model_vs30"
    "$vertextransform" "1"
    "$vertexnormal" "1"
    "$depthtest" "1"
