    "$writealpha" "0"
    "$cull" "0"
    "$nocull" "1"
    "$linearwrite" "1"
    "Proxies"
    {
        "CE8Gauge"
        {
            "GaugeState" "static"
            "GaugeMode" "6"
            "GaugeBrightness" "80"
            "GaugeOpacity" "1"
            "GaugeTint" "1 1 1"
            "ColorA" "0 2 0.021601001"
        }
    }
}
