"UnlitGeneric"
{
    "$model" "1"
    "$nodecal" "1"
    "$nocull" "1"
    "$translucent" "1"
    "$alpha" "1"
    "$surfaceprop" "default_silent"
    "$basetexture" "models/campaign_evolved/ce8/material_sets/weapons/jackal_shield/textures/barrier_glow"
    "$receiveflashlight" "0"
    "$additive" "1"
    "$energyoffset" "[0 0 0]"
    "$energyscale" "[15.000000000 0.250000000 1]"
    "$energycenter" "[0 0 0]"
    "$detailtexturetransform" "center 0 0 scale 1 1 rotate 0 translate 0 0"
    "$detail" "models/campaign_evolved/ce8/material_sets/weapons/jackal_shield/textures/barrier_flow"
    "$detailscale" "1"
    "$detailblendmode" "7"
    "$detailblendfactor" ".35"
    "Proxies"
    {
        "CE8Energy"
        {
            "Kind" "shield"
            "DetailStrength" ".35"
            "ShieldColor" "0.55208302 0.039489001 0.002875"
            "Brightness" "2"
            "RefractMaterial" "models/campaign_evolved/ce8/material_sets/weapons/jackal_shield_major/barrier_refract"
            "FarMaterial" "models/campaign_evolved/ce8/material_sets/weapons/jackal_shield_major/barrier_far"
        }
        "TextureScroll"
        {
            "textureScrollVar" "$energyoffset"
            "textureScrollRate" "0.500099990"
            "textureScrollAngle" "88.854237185"
        }
        "TextureTransform"
        {
            "centerVar" "$energycenter"
            "scaleVar" "$energyscale"
            "translateVar" "$energyoffset"
            "resultVar" "$detailtexturetransform"
        }
    }
}
