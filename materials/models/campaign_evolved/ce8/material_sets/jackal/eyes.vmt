            "EmissionTexture" "models/campaign_evolved/ce8/shader_inputs/emission_constant_000000"
            "EnvironmentTexture" "models/cubemaps/fallout4cube_dithered_grey"
            "FeatureTexture" "models/campaign_evolved/ce8/shader_inputs/white"
            "EnvironmentBRDFTexture" "models/campaign_evolved/ce8/shader_inputs/environment_brdf"
            "NormalStrength" "1"
            "RoughnessScale" "1"
            "RoughnessBias" "0"
