    "$linearread_texture5" "0"
    "$texture6" "models/campaign_evolved/ce8/shader_inputs/white" // FeatureTexture
    "$linearread_texture6" "1"
    "$texture7" "models/campaign_evolved/ce8/shader_inputs/environment_brdf" // EnvironmentBRDFTexture
    "$linearread_texture7" "1"
    "Proxies"
    {
