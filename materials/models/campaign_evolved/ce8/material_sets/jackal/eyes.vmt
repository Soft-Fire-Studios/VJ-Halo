    "$writealpha" "0"
    "$alpha_blend" "0"
    "$cull" "1"
    "$linearwrite" "1"
    "$basetexture" "models/campaign_evolved/ce8/material_sets/jackal/textures/eyes_dif" // AlbedoTexture
    "$linearread_basetexture" "0"
